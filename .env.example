# انسخي هذا الملف إلى .env.local للتطوير المحلي، وأضيفي نفس القيم في
# Netlify من: Site settings → Environment variables

# ---- Supabase (من إعدادات مشروعك في app.supabase.com → Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# مفتاح سرّي — لا تضعيه أبدًا في كود يصل المتصفح، فقط في بيئة الخادم
# (Netlify Functions / Route Handlers). يُستخدم لتجاوز RLS في عمليات محددة
# فقط (رفع الملفات، توليد روابط المعاينة المؤقتة، تحليل الذكاء الاصطناعي).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- الذكاء الاصطناعي (اختياري — المنصة تعمل بدونه، فقط ميزات AI تُعطَّل) ----
# من console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ---- Netlify (تُضبط تلقائيًا من Netlify عند النشر؛ لا حاجة لتعديلها يدويًا) ----
# URL=
# DEPLOY_URL=
